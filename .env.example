# --- Persistent storage (kept OUTSIDE the application directory in production) ---
# Local dev (Windows/macOS/Linux):
DATA_DIR=./data
# Production VPS:
# DATA_DIR=/var/www/souradeep-data

# Optional explicit overrides (default to $DATA_DIR/site.db and $DATA_DIR/uploads)
# DB_PATH=/var/www/souradeep-data/site.db
# UPLOADS_DIR=/var/www/souradeep-data/uploads

# Canonical site origin, used for SEO metadata, sitemap and Open Graph URLs
SITE_URL=https://your-domain.com

# --- Admin auth ---
ADMIN_USERNAME=souradeep
# Simplest: put your password here in plain text. It is hashed with scrypt on
# boot and only the hash is stored in SQLite — the app never keeps this value.
ADMIN_PASSWORD_HASH=YourPasswordHere
# Preferred for production: a pre-generated hash instead of the password.
# Generate with: npm run set-password -- "your-strong-password"
# ADMIN_PASSWORD_HASH=scrypt:16384:....

# Changing either value and restarting the app updates the admin login.

# Signs the HTTP-only session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
